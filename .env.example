DATABASE_URL=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
QDRANT_URL=""
QDRANT_API_KEY=""
NVIDIA_API_KEY=""
NVIDIA_LLM_MODEL="openai/gpt-oss-120b"
GROQ_API_KEY=""
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""
GROQ_LLM_MODEL="openai/gpt-oss-120b"
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"
GEMINI_WEB2API_BASE_URL=""
GEMINI_WEB2API_API_KEY=""
GEMINI_WEB_SEARCH="true"
FREELLM_BASE_URL="https://localhost/v1"
FREELLM_API_KEY=""

# LLM fallback (server-side only — never sent to the browser). When the primary provider fails with a
# rate limit / quota / timeout / outage / unavailable model, calls fall back along LLM_FALLBACK_CHAIN
# ("provider:model,…"). OpenRouter rotates over up to five keys: the key that last worked is reused,
# a key that hits 429/402/401 is put on a cooldown (Retry-After honoured) and rejoins automatically.
LLM_FALLBACK_CHAIN="openrouter:minimax/minimax-m3"
OPENROUTER_FALLBACK_MODEL="minimax/minimax-m3"
OPENROUTER_TIMEOUT="90"
OPENROUTER_API_KEY_1=""
OPENROUTER_API_KEY_2=""
OPENROUTER_API_KEY_3=""
OPENROUTER_API_KEY_4=""
OPENROUTER_API_KEY_5=""
# Agent: LLM repair rounds when an edit does not compile, before the whole change is rolled back.
SHADOW_COMPILE_MAX_RETRIES="2"

GUEST_TOKEN_SECRET=""
NEXT_PUBLIC_GA_ID=""

# PDF -> LaTeX importer (backend/pdf2latex). It uses the AI copilot's LLM (GEMINI_WEB2API_* above,
# model providers/router.DEFAULT_MODEL); there are no separate LLM settings. Non-LLM knobs only:
# pages converted in parallel (also the cap on concurrent LLM calls), LLM call timeout (s) and retries,
# LLM attempts to fix a page that fails to compile, the acceptance gate, comparison DPI.
#
# A page is accepted when it compiles to ONE page carrying COVERAGE_TARGET of the PDF's words with
# the median word no further than MAX_DISPLACEMENT pt from where the PDF puts it (coverage alone
# cannot tell a faithful page from a scrambled one: both carry every word).
# SIM_THRESHOLD is only the reported visual reference: full-page SSIM scores a blank page ~0.79 and
# a faithful reflow ~0.66, so it cannot decide whether a page is good. VISUAL_FLOOR is the backstop
# for a page that has all its words but looks nothing like the original.
PDF2LATEX_CONCURRENCY="4"
PDF2LATEX_PAGE_TIMEOUT="180"
PDF2LATEX_PAGE_RETRIES="2"
PDF2LATEX_MAX_COMPILE_REPAIRS="3"
PDF2LATEX_COVERAGE_TARGET="0.995"
PDF2LATEX_MAX_DISPLACEMENT="25"
PDF2LATEX_VISUAL_FLOOR="0.55"
PDF2LATEX_SIM_THRESHOLD="0.85"
PDF2LATEX_QUALITY_RERUN="true"
PDF2LATEX_MAX_FILE_MB="50"
PDF2LATEX_MAX_PAGES="50"
PDF2LATEX_RENDER_DPI="100"
PDF2LATEX_RATE_PER_HOUR="10"
PDF2LATEX_JOB_DIR=""

# ─────────────────────────────────────────────────────────────────────────────
# Realtime collaborative editing (backend/collab, lib/collab)
# ─────────────────────────────────────────────────────────────────────────────
# Multiple users editing one project at once, over a Yjs CRDT on a WebSocket at
# ${NEXT_PUBLIC_BACKEND_URL}/ws/collab/<project_id>. Nothing here is required:
# every value below is the default. See COLLABORATION.md.
#
# IMPORTANT — rooms are per-process. One uvicorn worker, or a proxy that pins
# /ws/collab/<project_id> to one worker (then set COLLAB_MULTI_WORKER=1).
# entrypoint.sh and Dockerfile.backend already pin WORKERS=1 while collaboration
# is on; set COLLAB_ENABLED=0 to go back to multiple workers.
COLLAB_ENABLED="1"
COLLAB_MULTI_WORKER="0"

# Origins allowed to open a collaboration socket. WebSocket is exempt from CORS,
# so this is what stops another site opening a room with a visitor's cookie.
# Defaults to ALLOWED_ORIGINS + NEXT_PUBLIC_APP_URL + BETTER_AUTH_URL.
COLLAB_ALLOWED_ORIGINS=""
COLLAB_REQUIRE_ORIGIN="1"

# Persistence: the room writes the document to disk + Supabase latex_documents
# after this much edit silence, and at least this often while someone types
# continuously. Never per keystroke.
COLLAB_PERSIST_DEBOUNCE="2.0"
COLLAB_PERSIST_MAX_INTERVAL="15.0"

# How long an empty room is kept in memory, so a refresh rejoins the same live
# document instead of paying a cold load.
COLLAB_ROOM_IDLE_TTL="60"

# How often an open socket's project membership is re-checked, so removing a
# collaborator ends their live session rather than their next page load.
COLLAB_REAUTH_INTERVAL="30"

# One-time websocket admission tickets (POST /api/collab/ticket). Only used when
# the browser will not attach cookies to the upgrade (cross-site deployments).
# Signed with COLLAB_TICKET_SECRET, falling back to BETTER_AUTH_SECRET.
COLLAB_TICKET_SECRET=""
COLLAB_TICKET_TTL="60"

# Limits and the set of files synchronized as text (binary assets keep the
# existing upload path — a CRDT of a PNG buys nothing).
COLLAB_MAX_CONNECTIONS_PER_ROOM="32"
COLLAB_MAX_ROOMS="500"
COLLAB_MAX_FILES_PER_ROOM="64"
COLLAB_MAX_MESSAGE_BYTES="2097152"
COLLAB_MAX_FILE_BYTES="4194304"
COLLAB_TEXT_EXTENSIONS=".tex,.bib,.cls,.sty,.txt,.md,.bbl"

# Where the CRDT snapshots live (restart safety). Defaults to uploads/collab-state.
COLLAB_STATE_DIR=""

# Verbose COLLAB_* logging. COLLAB_DEBUG promotes per-message events to INFO on
# the backend; NEXT_PUBLIC_COLLAB_DEBUG does the same in the browser console
# (or set localStorage.ob_collab_debug = "1" for one user, with no redeploy).
COLLAB_DEBUG="0"
NEXT_PUBLIC_COLLAB_DEBUG="0"

# Turn the client off without touching the backend.
NEXT_PUBLIC_COLLAB_ENABLED="1"
