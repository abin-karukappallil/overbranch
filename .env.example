OPENROUTER_API_KEY_1=""
OPENROUTER_API_KEY_2=""
OPENROUTER_API_KEY_3=""
OPENROUTER_API_KEY_4=""
OPENROUTER_API_KEY_5=""
SHADOW_COMPILE_MAX_RETRIES="2"
AGENT_ATTACH_MAX_FILES="5"
AGENT_ATTACH_MAX_MB="25"
AGENT_ATTACH_PREVIEW_CHARS="48000"
AGENT_ATTACH_AUTO_FIGURES="6"
AGENT_ATTACH_AUTO_TABLES="2"
AGENT_VIEW_DPI="110"
AGENT_VISUAL_REPAIR_ROUNDS="1"

GUEST_TOKEN_SECRET=""
NEXT_PUBLIC_GA_ID=""
PDF2LATEX_CONCURRENCY="4"
PDF2LATEX_PAGE_TIMEOUT="180"
PDF2LATEX_PAGE_RETRIES="2"
PDF2LATEX_MAX_COMPILE_REPAIRS="3"
PDF2LATEX_COVERAGE_TARGET="0.995"
PDF2LATEX_MAX_DISPLACEMENT="25"
PDF2LATEX_VISUAL_FLOOR="0.55"
PDF2LATEX_SIM_THRESHOLD="0.85"
PDF2LATEX_QUALITY_RERUN="true"
PDF2LATEX_MAX_FILE_MB="50"
PDF2LATEX_MAX_PAGES="50"
PDF2LATEX_RENDER_DPI="100"
PDF2LATEX_RATE_PER_HOUR="10"
PDF2LATEX_JOB_DIR=""

COLLAB_ENABLED="1"
COLLAB_MULTI_WORKER="0"

# Origins allowed to open a collaboration socket. WebSocket is exempt from CORS,
# so this is what stops another site opening a room with a visitor's cookie.
# Defaults to ALLOWED_ORIGINS + NEXT_PUBLIC_APP_URL + BETTER_AUTH_URL.
COLLAB_ALLOWED_ORIGINS=""
COLLAB_REQUIRE_ORIGIN="1"

# Persistence: the room writes the document to disk + Supabase latex_documents
# after this much edit silence, and at least this often while someone types
# continuously. Never per keystroke.
COLLAB_PERSIST_DEBOUNCE="2.0"
COLLAB_PERSIST_MAX_INTERVAL="15.0"

# How long an empty room is kept in memory, so a refresh rejoins the same live
# document instead of paying a cold load.
COLLAB_ROOM_IDLE_TTL="60"

# How often an open socket's project membership is re-checked, so removing a
# collaborator ends their live session rather than their next page load.
COLLAB_REAUTH_INTERVAL="30"

# One-time websocket admission tickets (POST /api/collab/ticket). Only used when
# the browser will not attach cookies to the upgrade (cross-site deployments).
# Signed with COLLAB_TICKET_SECRET, falling back to BETTER_AUTH_SECRET.
COLLAB_TICKET_SECRET=""
COLLAB_TICKET_TTL="60"

# Limits and the set of files synchronized as text (binary assets keep the
# existing upload path — a CRDT of a PNG buys nothing).
COLLAB_MAX_CONNECTIONS_PER_ROOM="32"
COLLAB_MAX_ROOMS="500"
COLLAB_MAX_FILES_PER_ROOM="64"
COLLAB_MAX_MESSAGE_BYTES="2097152"
COLLAB_MAX_FILE_BYTES="4194304"
COLLAB_TEXT_EXTENSIONS=".tex,.bib,.cls,.sty,.txt,.md,.bbl"

# Where the CRDT snapshots live (restart safety). Defaults to uploads/collab-state.
COLLAB_STATE_DIR=""

# Verbose COLLAB_* logging. COLLAB_DEBUG promotes per-message events to INFO on
# the backend; NEXT_PUBLIC_COLLAB_DEBUG does the same in the browser console
# (or set localStorage.ob_collab_debug = "1" for one user, with no redeploy).
COLLAB_DEBUG="0"
NEXT_PUBLIC_COLLAB_DEBUG="0"

# Turn the client off without touching the backend.
NEXT_PUBLIC_COLLAB_ENABLED="1"
