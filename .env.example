DATABASE_URL=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
QDRANT_URL=""
QDRANT_API_KEY=""
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"

# --- LLM: strict Web2API gateway chain -------------------------------------
# Every agent / pdf2latex / file-analysis request tries these gateways IN THIS
# ORDER and cycles the whole chain LLM_CHAIN_CYCLES times (attempts =
# gateways x cycles, 1/2/4/8/15s back-off between cycles). A gateway that timed
# out or answered 5xx is skipped for LLM_GATEWAY_COOLDOWN seconds unless all of
# them are cooling. If every attempt fails the user sees only
# "Model outage - please retry".
# OpenRouter, Groq, NVIDIA and FreeLLM are NOT used by the chain any more; the
# NVIDIA_/GROQ_/OPENROUTER_ variables below are ignored by it.
WEB2API_GATEWAYS="https://g1.overbranch.app/v1,https://g2.overbranch.app/v1,https://g3.overbranch.app/v1,https://g4.overbranch.app/v1,https://g5.overbranch.app/v1,https://model.overbranch.app/v1,https://overmodel.abinthomas.dev/v1"
WEB2API_API_KEY=""
LLM_CHAIN_CYCLES="12"
# Max silence between two streamed chunks before a gateway counts as hung (a slow
# answer that keeps streaming is never cut off) and the hard cap on one attempt.
LLM_IDLE_TIMEOUT="120"
LLM_ATTEMPT_WALL_CAP="300"
LLM_GATEWAY_COOLDOWN="30"
# Legacy single-endpoint setup, only read when WEB2API_GATEWAYS is empty:
# GEMINI_WEB2API_BASE_URL="" / GEMINI_WEB2API_API_KEY="" (then GEMINI2_WEB2API_*)
GEMINI_WEB_SEARCH="true"
# Unused by the chain (kept so old .env files still parse):
NVIDIA_API_KEY=""
NVIDIA_LLM_MODEL="openai/gpt-oss-120b"
GROQ_API_KEY=""
GROQ_LLM_MODEL="openai/gpt-oss-120b"
OPENROUTER_API_KEY_1=""
SHADOW_COMPILE_MAX_RETRIES="2"
AGENT_ATTACH_MAX_FILES="5"
AGENT_ATTACH_MAX_MB="25"
AGENT_ATTACH_PREVIEW_CHARS="48000"
AGENT_ATTACH_AUTO_FIGURES="6"
AGENT_ATTACH_AUTO_TABLES="2"
AGENT_VIEW_DPI="110"
AGENT_VISUAL_REPAIR_ROUNDS="1"

GUEST_TOKEN_SECRET=""
NEXT_PUBLIC_GA_ID=""
PDF2LATEX_CONCURRENCY="4"
PDF2LATEX_PAGE_TIMEOUT="180"
# The gateway chain already retries; page-level retries would nest on top of it.
PDF2LATEX_PAGE_RETRIES="0"
PDF2LATEX_MAX_COMPILE_REPAIRS="3"
PDF2LATEX_COVERAGE_TARGET="0.995"
PDF2LATEX_MAX_DISPLACEMENT="25"
PDF2LATEX_VISUAL_FLOOR="0.55"
PDF2LATEX_SIM_THRESHOLD="0.85"
PDF2LATEX_QUALITY_RERUN="true"
PDF2LATEX_MAX_FILE_MB="50"
PDF2LATEX_MAX_PAGES="100"
PDF2LATEX_RENDER_DPI="100"
PDF2LATEX_RATE_PER_HOUR="10"
PDF2LATEX_JOB_DIR=""

COLLAB_ENABLED="1"
COLLAB_MULTI_WORKER="0"

# Origins allowed to open a collaboration socket. WebSocket is exempt from CORS,
# so this is what stops another site opening a room with a visitor's cookie.
# Defaults to ALLOWED_ORIGINS + NEXT_PUBLIC_APP_URL + BETTER_AUTH_URL.
COLLAB_ALLOWED_ORIGINS=""
COLLAB_REQUIRE_ORIGIN="1"

# Persistence: the room writes the document to disk + Supabase latex_documents
# after this much edit silence, and at least this often while someone types
# continuously. Never per keystroke.
COLLAB_PERSIST_DEBOUNCE="2.0"
COLLAB_PERSIST_MAX_INTERVAL="15.0"

# How long an empty room is kept in memory, so a refresh rejoins the same live
# document instead of paying a cold load.
COLLAB_ROOM_IDLE_TTL="60"

# How often an open socket's project membership is re-checked, so removing a
# collaborator ends their live session rather than their next page load.
COLLAB_REAUTH_INTERVAL="30"

# One-time websocket admission tickets (POST /api/collab/ticket). Only used when
# the browser will not attach cookies to the upgrade (cross-site deployments).
# Signed with COLLAB_TICKET_SECRET, falling back to BETTER_AUTH_SECRET.
COLLAB_TICKET_SECRET=""
COLLAB_TICKET_TTL="60"

# Limits and the set of files synchronized as text (binary assets keep the
# existing upload path — a CRDT of a PNG buys nothing).
COLLAB_MAX_CONNECTIONS_PER_ROOM="32"
COLLAB_MAX_ROOMS="500"
COLLAB_MAX_FILES_PER_ROOM="64"
COLLAB_MAX_MESSAGE_BYTES="2097152"
COLLAB_MAX_FILE_BYTES="4194304"
COLLAB_TEXT_EXTENSIONS=".tex,.bib,.cls,.sty,.txt,.md,.bbl"

# Where the CRDT snapshots live (restart safety). Defaults to uploads/collab-state.
COLLAB_STATE_DIR=""

# Verbose COLLAB_* logging. COLLAB_DEBUG promotes per-message events to INFO on
# the backend; NEXT_PUBLIC_COLLAB_DEBUG does the same in the browser console
# (or set localStorage.ob_collab_debug = "1" for one user, with no redeploy).
COLLAB_DEBUG="0"
NEXT_PUBLIC_COLLAB_DEBUG="0"

# Turn the client off without touching the backend.
NEXT_PUBLIC_COLLAB_ENABLED="1"

# ============================================================
# TeX compilation sandbox
# ============================================================

# Where engines run.
#   local  — child processes of the backend, inside the app container.
#            Isolation is the app container's; a document can read any file
#            the backend can, including other projects under uploads/. This is
#            the default and needs no extra setup.
#   docker — one container per compile from TEX_COMPILER_IMAGE, with no
#            network, a read-only root filesystem and only its own project
#            directory mounted. Needs the docker socket and TEX_JOB_DIR; see
#            the commented volumes in docker-compose.yml.
TEX_SANDBOX_MODE="local"

# The TeX Live image used in docker mode. Pinned deliberately: never a
# `latest` tag, so a redeploy cannot change TeX Live under a document that
# compiled yesterday. Pull or build it as a deploy step, never on a request —
# the backend refuses to pull during a compile.
TEX_COMPILER_IMAGE="quay.io/sharelatex/texlive-full:2025.1"

# docker mode only: the parent directory for per-compile job directories.
# `docker run -v` resolves paths on the Docker HOST, so when the backend runs
# in a container this must be a host directory bind-mounted into it at the
# SAME path on both sides, or every compile sees an empty directory. Leave
# empty to use the system temp directory (correct when the backend runs on the
# host itself).
TEX_JOB_DIR=""

# Per-compile resource ceilings. MAX_CONCURRENT_COMPILES bounds how many
# compiles exist at once, so the service's worst case is the product of the two.
TEX_CPU_LIMIT="1.0"
TEX_MEMORY_LIMIT_MB="2048"
TEX_PIDS_LIMIT="256"            # docker mode only (cgroup pids limit)
TEX_FILE_SIZE_LIMIT_MB="256"    # largest single file a compile may write
TEX_CPU_SECONDS_LIMIT="0"       # CPU-seconds per engine process; 0 = wall clock only
TEX_OUTPUT_MAX_MB="100"         # largest PDF the API will return

# Reuse of a project's .aux/.bbl/.toc/.fdb_latexmk between compiles, which is
# what lets an unchanged bibliography skip bibtex and a settled document skip
# its second pass. Source files are never cached and main.pdf is never
# restored, so a failed compile cannot return a stale document. Set to 0 to
# make every compile cold.
TEX_AUX_CACHE="1"
TEX_AUX_CACHE_DIR=""            # defaults to /tmp/overbranch_aux_cache
TEX_AUX_CACHE_MAX_AGE="86400"
