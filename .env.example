NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"
GEMINI_WEB2API_BASE_URL=""
GEMINI_WEB2API_API_KEY=""
GEMINI_WEB_SEARCH="true"
GEMINI_TIMEOUT="90.0"
GEMINI2_WEB2API_BASE_URL=""
GEMINI2_WEB2API_API_KEY=""
FREELLM_BASE_URL="https://localhost/v1"
FREELLM_API_KEY=""
LLM_FALLBACK_CHAIN="gemini2,openrouter:minimax/minimax-m3"
LLM_PROVIDER_ATTEMPT_TIMEOUT="120.0"
OPENROUTER_FALLBACK_MODEL="minimax/minimax-m3"
