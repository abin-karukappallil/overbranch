# ==============================================================================
# OverBranch - Standalone LaTeX & Python Backend Container
# Dedicated Dockerfile for deploying only the FastAPI compiler & AI backend
# ==============================================================================

FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# 1. Install System Dependencies: Complete TeX Live Suite & PDF Processing Tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    texlive-base \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-bibtex-extra \
    texlive-extra-utils \
    texlive-pictures \
    texlive-fonts-recommended \
    texlive-fonts-extra \
    texlive-science \
    texlive-publishers \
    texlive-xetex \
    texlive-luatex \
    texlive-lang-greek \
    cm-super \
    fonts-dejavu \
    fonts-lmodern \
    fonts-urw-base35 \
    latexmk \
    ghostscript \
    poppler-utils \
    perl \
    ca-certificates \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. Install Python Dependencies
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

# 3. Copy Backend Code & Templates
COPY backend ./backend

# 4. Create uploads directory for project storage
RUN mkdir -p /app/uploads/projects

# Set Working Directory to backend for uvicorn
WORKDIR /app/backend

ENV PORT=8000
ENV HOST=0.0.0.0
ENV WORKERS=2
ENV UPLOADS_BASE_DIR=/app/uploads/projects

EXPOSE 8000

VOLUME ["/app/uploads"]

# Health check to ensure Docker and reverse proxies can detect hung workers
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:${PORT:-8000}/api/health || exit 1

# Production Uvicorn startup with multi-worker concurrency, keepalive > proxy timeout, and request recycling
CMD exec python3 -m uvicorn main:app \
    --host 0.0.0.0 \
    --port ${PORT:-8000} \
    --workers ${WORKERS:-2} \
    --timeout-keep-alive 65 \
    --timeout-graceful-shutdown 30 \
    --limit-concurrency 100 \
    --limit-max-requests 2000

